# Copy the contents of this file into `backend/src/.env` (or `backend/.env`) and update values.

# Application
APP_NAME="Your app name here"
APP_DESCRIPTION="Your app description here"
APP_VERSION="0.1"
CONTACT_NAME="Your name"
CONTACT_EMAIL="you@example.com"
LICENSE_NAME="MIT"
TERMS_VERSION="v1"

# Environment
ENVIRONMENT="local"  # local, dev, test, staging, or production

# Safe only for local/test. Shared environments must inject a unique value
# generated with `openssl rand -hex 32`; startup rejects this local sentinel.
SECRET_KEY="local-test-only-signing-key-do-not-use-in-shared-environments-2026"

# Authentication mode defaults to the real OIDC identity path. The local
# persona adapter requires ENVIRONMENT=local, AUTH_MODE=local_dev,
# ENABLE_DEV_ROLE_SELECTOR=true, and OIDC_ENABLED=false. The values below keep
# it disabled by default; partial or conflicting opt-in stops configuration
# loading.
AUTH_MODE="oidc"  # oidc or local_dev
ENABLE_DEV_ROLE_SELECTOR=false
DEV_SESSION_ALLOWED_ORIGINS='["http://127.0.0.1:3000","http://localhost:3000"]'

# Database
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_password"
POSTGRES_SERVER="localhost"  # Use "db" for Docker Compose
POSTGRES_PORT=5432
POSTGRES_DB="your_database_name"

# Sessions & OIDC
SESSION_COOKIE_NAME="app_session"
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=28800
SESSION_ROLLING=false
SESSION_COOKIE_DOMAIN=".canada.ca"

# Redis — Session store (primary / canonical Redis connection)
# Cache, Queue, and Rate-limiter host/port/password/TLS settings fall back to
# these values when their own variables are blank. Their DB numbers do not
# cascade; session defaults to DB 1 and the other Redis clients to DB 0.
REDIS_SESSION_HOST="localhost"
REDIS_SESSION_PORT=6379
REDIS_SESSION_DB=1
REDIS_SESSION_PASSWORD=
REDIS_SESSION_SSL=false   # Set to true for production / AWS ElastiCache (transit_encryption_enabled)
REDIS_SESSION_PREFIX="app.sessions."
REDIS_SESSION_GC_TTL=2592000  # 30 days in seconds

# OIDC
OIDC_ENABLED=false
OIDC_PROVIDER_NAME="oidc"
OIDC_SERVER_METADATA_URL="https://your-idp/.well-known/openid-configuration"
OIDC_CLIENT_ID="your-client-id"
OIDC_CLIENT_SECRET="your-client-secret"
OIDC_SCOPES="openid profile email"
# Exact email domains allowed to receive partner workspace access. Shared
# environments must configure this JSON list explicitly.
PARTNER_ACCESS_ALLOWED_EMAIL_DOMAINS='["example.gc.ca"]'
OIDC_POST_LOGIN_REDIRECT="http://localhost:3000/auth-complete"
OIDC_ACCESS_DENIED_REDIRECT="http://localhost:3000/access-denied"
OIDC_POST_LOGOUT_REDIRECT_URI="http://localhost:3000"

# Controlled, explicitly invoked bootstrap target. Leave empty during normal
# application startup and set only while running create_initial_cl_admin.
INITIAL_CL_ADMIN_EMAIL=

# Redis — Cache (leave blank to inherit session connection params)
# DB defaults to 0 when unset.
REDIS_CACHE_HOST=
REDIS_CACHE_PORT=
REDIS_CACHE_DB=
REDIS_CACHE_PASSWORD=
REDIS_CACHE_SSL=   # Set to true for production / AWS ElastiCache

# Redis — Queue / ARQ background jobs (leave blank to inherit session params)
REDIS_QUEUE_HOST=
REDIS_QUEUE_PORT=
REDIS_QUEUE_DB=
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_SSL=   # Set to true for production / AWS ElastiCache

# Redis — Rate limiter (connection params can inherit session Redis; DB cannot)
REDIS_RATE_LIMIT_HOST=
REDIS_RATE_LIMIT_PORT=
REDIS_RATE_LIMIT_DB=
REDIS_RATE_LIMIT_PASSWORD=
REDIS_RATE_LIMIT_SSL=   # Set to true for production / AWS ElastiCache

# Worker
TIMEZONE="America/Toronto"
LOAD_MAU_ENABLED=false # Feature Flag
# Legacy mutating IBM RP sync is available only for local/test fixtures. Keep
# this false elsewhere until the reviewed partner-linking workflow exists;
# configuration rejects enablement in dev, staging, and production.
IBM_RP_APPLICATION_SYNC_ENABLED=false

# Rate limiting
DEFAULT_RATE_LIMIT_LIMIT=10
DEFAULT_RATE_LIMIT_PERIOD=3600

# Credentialed CORS requires exact origins, methods, and headers.
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
CORS_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_HEADERS=["Accept","Content-Type","Idempotency-Key","X-Request-ID"]

# Misc
CLIENT_CACHE_MAX_AGE=30
FILE_LOG_ENABLED=false  # opt in only when local rotating files are required

# Docker-compose overrides (optional — set REDIS_SESSION_HOST to cover all clients)
# POSTGRES_SERVER="db"
# REDIS_SESSION_HOST="redis"
# REDIS_CACHE_HOST="redis"      # or leave blank to use REDIS_SESSION_HOST
# REDIS_QUEUE_HOST="redis"      # or leave blank to use REDIS_SESSION_HOST
# REDIS_RATE_LIMIT_HOST="redis" # or leave blank to use REDIS_SESSION_HOST

# IBM Security Verify - Admin API (server-to-server, client credentials)
# Bounded to Partner Portal RP discovery/adoption, supported RP configuration,
# client-secret operations, and application-scoped login counts. This is not a
# generic users/groups/applications administration surface.
# This is NOT for end-user login - see OIDC config above for user authentication.
IBM_SV_ADMIN_BASE_URL="https://your-tenant.verify.ibm.com"
IBM_SV_ADMIN_CLIENT_ID="your-api-client-id"
IBM_SV_ADMIN_CLIENT_SECRET="your-api-client-secret"

# Frontend base used to generate copyable invitation links. The portal does not
# send invitation email; an authorized administrator shares the link manually.
RP_APPLICATION_INVITE_URL_BASE="http://localhost:3000/invitations/rp-applications"
RP_APPLICATION_INVITATION_EXPIRE_DAYS=7

# AWS S3 — MAU data loading
# Auth via IAM role assumption (cross-account).  The ECS task role (prod) or SSO
# profile (local) must have sts:AssumeRole on the role below.
# Used by the ARQ cron job to load Monthly Active User CSV files (yesterday's data).
# Files expected at: s3://{bucket}/{folder}/date={yyyy-mm-dd}/app_login_counts.csv
#   Example: s3://{bucket}/ibm_verify/app_login_counts/date=2026-06-11/app_login_counts.csv
# CSV columns: application_name,total_logins,unique_users,failed_logins,successful_logins,mtd_unique_users,date
#   unique_users = daily unique users; mtd_unique_users (month-to-date) is stored as MAU per application per date
AWS_S3_REGION="ca-central-1"
AWS_S3_ROLE_ARN="arn:aws:iam::320765978564:role/cl-pp-mau-s3-read"
# AWS_S3_PROFILE="cl-pp-dev"  # uncomment for local dev — set to your SSO profile name, or use your default
S3_MAU_BUCKET_NAME="your-mau-data-bucket"
S3_MAU_FOLDER="ibm_verify/app_login_counts/"
