# ============================================================================
# WARNING: EXAMPLE CONFIGURATION - DO NOT USE IN PRODUCTION AS-IS
# ============================================================================
# This file contains example values for development/testing purposes only.
#
# SECURITY CRITICAL: Before deploying to production, you MUST:
#   1. Copy this file to src/.env
#   2. Generate a new SECRET_KEY using: openssl rand -hex 32
#   3. Change all passwords (POSTGRES_PASSWORD, etc.)
#   4. Update all sensitive configuration values
#
# Using these example values in production is a SECURITY RISK.
# ============================================================================

# ------------- app settings -------------
APP_NAME="My Project"
APP_DESCRIPTION="My Project Description"
APP_VERSION="0.1"
CONTACT_NAME="Me"
CONTACT_EMAIL="my.email@example.com"
LICENSE_NAME="MIT"

# ------------- database -------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=1234
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_DB="postgres"
POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"

# ------------- crypt -------------
SECRET_KEY=local-test-only-signing-key-do-not-use-in-shared-environments-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------- redis cache -------------
REDIS_CACHE_HOST="redis"
REDIS_CACHE_PORT=6379

# ------------- redis queue -------------
REDIS_QUEUE_HOST="redis"
REDIS_QUEUE_PORT=6379

# ------------- redis rate limit -------------
REDIS_RATE_LIMIT_HOST="redis"
REDIS_RATE_LIMIT_PORT=6379

# ------------- client side cache -------------
CLIENT_CACHE_MAX_AGE=60

# ------------- CORS -------------
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
CORS_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_HEADERS=["Accept","Content-Type","Idempotency-Key","X-Request-ID"]

# ------------- test -------------
TEST_NAME="Tester User"
TEST_EMAIL="test@tester.com"
TEST_USERNAME="testeruser"
TEST_PASSWORD="Str1ngT3st!"

# ------------- environment -------------
ENVIRONMENT="local"
AUTH_MODE="local_dev"
ENABLE_DEV_ROLE_SELECTOR=true
OIDC_ENABLED=false
DEV_SESSION_ALLOWED_ORIGINS='["http://127.0.0.1:3000","http://localhost:3000"]'

# ------------- server-side local sessions -------------
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
REDIS_SESSION_HOST="redis"
REDIS_SESSION_PORT=6379
REDIS_SESSION_DB=1

# ------------- first tier -------------
TIER_NAME="free"
