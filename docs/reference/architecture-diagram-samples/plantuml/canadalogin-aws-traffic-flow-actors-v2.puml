@startuml
' CanadaLogin-style AWS traffic flow source model.
'
' Version: actor-treatment pass after updating the AWS topology skill.
' Work context: local illustrative sample only.
' Source: user-provided prompt and reference sketch.
' View: traffic-flow topology overlay.
' Sensitive data rule: no account IDs, real domains, secrets, or live AWS
' discovery. Service labels are illustrative prompt-test labels.
'
' Actor handling:
' - Human users are represented with PlantUML actor notation.
' - The browser context is included in the actor label instead of adding a
'   separate browser system node.
' - The actor stays outside AWS, VPC, SaaS, and partner boundaries.
' - Systems such as IBM Verify, API Gateway, queues, Lambda, and SIEM stay as
'   system/service boxes.

!include <awslib/AWSCommon.puml>
!include <awslib/Groups/all.puml>
!include <awslib/NetworkingContentDelivery/all.puml>
!include <awslib/SecurityIdentityCompliance/all.puml>
!include <awslib/Containers/all.puml>
!include <awslib/Database/all.puml>
!include <awslib/Storage/all.puml>

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam wrapWidth 140
skinparam nodesep 34
skinparam ranksep 38
skinparam defaultTextAlignment center

title AWS Traffic Flow Topology - Actor Treatment v2

actor "External Users\n(Web browsers)" as users <<External>>

AWSCloudGroup(awsBoundary, "AWS account / ca-central-1 workload boundary") {
  Route53(route53, "Route 53", "DNS")

  RegionGroup(region, "Canada Central Region") {
    rectangle "Application traffic flow" as appFlow {
      WAF(regionalWaf, "Regional WAF", "inspection on ALBs")

      VPCGroup(appVpc, "Application VPC\nspans 3 AZs: ca-central-1a / 1b / 1d\nresources shown once") {
        PublicSubnetGroup(publicSubnets, "Public subnets\n3 AZs") {
          ElasticLoadBalancingApplicationLoadBalancer(albSelfservice, "ALB Selfservice", "api / selfservice")
          ElasticLoadBalancingApplicationLoadBalancer(albMigration, "ALB Migration", "api / migration")
        }

        PrivateSubnetGroup(privateAppSubnets, "Private app subnets\n3 AZs") {
          ElasticContainerService(ecsSelfservice, "ECS Fargate\nSelfservice", "service")
          ElasticContainerService(ecsMigration, "ECS Fargate\nMigration", "service")
        }

        PrivateSubnetGroup(dataSubnets, "Private data subnets\n3 AZs") {
          ElastiCache(redisSelfservice, "Valkey 7.2\nSelfservice", "cache")
          ElastiCache(redisMigration, "Valkey 7.2\nMigration", "cache")
        }
      }

      rectangle "ECS dependencies shown\nwithout flow arrows" as ecsDependencies {
        ElasticContainerRegistry(ecr, "ECR", "container images")
        rectangle "Route 53 Resolver\nDNS Firewall" as dnsFirewall
        SecretsManager(secrets, "Secrets Manager", "runtime secrets")
      }
    }
  }

  rectangle "Static website flow" as staticFlow {
    WAF(edgeWaf, "Edge WAF", "CloudFront WAF")
    CloudFront(cloudFront, "CloudFront", "static distribution")
    SimpleStorageService(s3Origins, "S3 origins", "static website assets")
  }
}

rectangle "Optional Verify webhook path" as verifyWebhook <<External>> {
  rectangle "IBM Verify" as ibmVerify
  rectangle "API Gateway\nwebhook ingress" as apiGateway
  rectangle "Ingest queue\nevents" as ingestQueue
  rectangle "Forwarder Lambda\nforward logs" as lambdaForwarder
  rectangle "SIEM / Sentinel" as siem
}

users --> route53 : HTTPS

' Application prompt shorthand:
' Users -> Route 53 -> ALB -> WAF -> ECS.
route53 --> albSelfservice : api.*
route53 --> albMigration : api.*
albSelfservice --> regionalWaf : WAF association\nshorthand
albMigration --> regionalWaf : WAF association\nshorthand
regionalWaf --> ecsSelfservice : inspected HTTPS
regionalWaf --> ecsMigration : inspected HTTPS

' Static website prompt shorthand:
' Users -> Route 53 -> WAF -> CloudFront -> S3.
route53 --> edgeWaf : static.*
edgeWaf --> cloudFront : HTTPS
cloudFront --> s3Origins : origin fetch

' Optional lower-priority webhook overlay.
ibmVerify -[#475569,dashed]-> apiGateway : webhook
apiGateway -[#475569,dashed]-> ingestQueue
ingestQueue -[#475569,dashed]-> lambdaForwarder
lambdaForwarder -[#475569,dashed]-> siem

' Local layout hints only. Do not read these as runtime dependencies.
appFlow -[hidden]right-> staticFlow
publicSubnets -[hidden]right-> privateAppSubnets
privateAppSubnets -[hidden]right-> dataSubnets
albSelfservice -[hidden]down-> albMigration
ecsSelfservice -[hidden]down-> ecsMigration
redisSelfservice -[hidden]down-> redisMigration
awsBoundary -[hidden]down-> verifyWebhook

legend right
  Actor-treatment pass from the updated skill.
  Human users render as a PlantUML actor/person node, not a service box.
  Browser context is included in the actor label.
  The actor remains outside AWS, VPC, SaaS, and partner boundaries.
  App flow remains: Users -> Route 53 -> ALB -> WAF -> ECS services.
  Static flow remains: Users -> Route 53 -> WAF -> CloudFront -> S3.
  ECS services remain Selfservice and Migration.
  AZ depiction remains a label: resources span 3 AZs and are not triplicated.
endlegend

@enduml
