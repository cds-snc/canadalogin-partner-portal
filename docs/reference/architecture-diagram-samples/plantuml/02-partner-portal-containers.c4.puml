@startuml
' CanadaLogin Partner Portal - C4 level 2 container view.
'
' Work context: local illustrative sample only.
' Source codebase: gc-signin-partner-portal, read as source material only.
' View question: what runtime containers make up the Partner Portal?
' Excluded: cloud topology, component internals, route-by-route behavior,
' invitation communication channels, and production configuration.

!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
skinparam wrapWidth 175
skinparam maxMessageSize 130

title CanadaLogin Partner Portal - C4 Level 2 Containers

Person(portalUser, "Portal role holder", "CL Admin, RP Admin, RP User (Edit), or Read Only.")

System_Ext(oidcProvider, "CanadaLogin / OIDC identity provider", "Authenticates portal users and returns verified claims.")
System_Ext(ibmVerify, "IBM Security Verify", "RP registrations and client credentials used through bounded operations.")
System_Ext(mauSource, "Approved MAU data source", "Supplies RP-configuration usage records.")

System_Boundary(portal, "CanadaLogin Partner Portal") {
  Container(webUi, "Portal web UI", "React, TypeScript, Vite, TanStack Router/Query", "Bilingual dashboard anchors and focused access, workspace, Application, RP-configuration, invitation, credential, MAU, checklist, and Production-review flows.")
  Container(api, "Backend API", "FastAPI, SQLAlchemy, Authlib, Casbin", "Backend-for-frontend, OIDC session authority, immutable role/workspace authorization, domain workflows, one-time invitation links, safe provider access, and standardized errors.")
  Container(worker, "Background worker", "ARQ", "Loads approved MAU data and runs registered queued or scheduled work.")
  ContainerDb(postgres, "PostgreSQL database", "PostgreSQL", "Users, fixed roles, assignments, Departments, workspaces, Applications, contacts, RP configurations, invitation hashes/history, registration completion, Production review, and required audit history.")
  ContainerDb(redis, "Redis", "Redis", "Server sessions, caches, runtime rate-limit counters, and ARQ queue state.")
}

Rel(portalUser, webUi, "Uses", "Browser / HTTPS")
Rel(webUi, api, "Calls scoped APIs", "JSON / HTTPS with secure cookie")
Rel(api, oidcProvider, "Starts login and handles callback", "OIDC / Authlib")
Rel(api, ibmVerify, "Performs authorized RP and credential operations", "HTTPS / OAuth2")
Rel(api, postgres, "Reads and writes portal records", "SQLAlchemy async / asyncpg")
Rel(api, redis, "Stores sessions, caches, rate counters, and queued jobs", "Redis protocol")
Rel(worker, redis, "Dequeues jobs and writes MAU cache", "ARQ / Redis")
Rel(worker, mauSource, "Loads approved usage records", "S3-compatible data access")

SHOW_LEGEND()
@enduml
