#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
zero_sha="0000000000000000000000000000000000000000"
verification_files=()
has_verification_files=0

append_stream_files() {
	while IFS= read -r file; do
		[ -z "${file}" ] && continue
		verification_files+=("${file}")
		has_verification_files=1
	done
}

append_range_files() {
	local range_start="$1"
	local range_end="$2"

	append_stream_files < <(
		git -C "${repo_root}" diff --name-only --diff-filter=ACMRT "${range_start}" "${range_end}" || true
	)
}

if [ ! -t 0 ]; then
	while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
		[ -z "${local_sha:-}" ] && continue
		[ "${local_sha}" = "${zero_sha}" ] && continue

		if [ -n "${remote_sha:-}" ] && [ "${remote_sha}" != "${zero_sha}" ] &&
			git -C "${repo_root}" rev-parse "${remote_sha}^{commit}" >/dev/null 2>&1; then
			append_range_files "${remote_sha}" "${local_sha}"
			continue
		fi

		if upstream_ref="$(git -C "${repo_root}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" &&
			merge_base="$(git -C "${repo_root}" merge-base "${local_sha}" "${upstream_ref}" 2>/dev/null)"; then
			append_range_files "${merge_base}" "${local_sha}"
			continue
		fi

		append_stream_files < <(
			git -C "${repo_root}" diff-tree --no-commit-id --name-only --diff-filter=ACMRT -r "${local_sha}" || true
		)
	done
fi

if [ "${has_verification_files}" -eq 0 ] &&
	upstream_ref="$(git -C "${repo_root}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" &&
	merge_base="$(git -C "${repo_root}" merge-base HEAD "${upstream_ref}" 2>/dev/null)"; then
	append_range_files "${merge_base}" HEAD
fi

echo "Running pre-push local verification: lint, typecheck, format checks, secret checks, fast tests, and optional container checks."
if [ "${has_verification_files}" -eq 1 ]; then
	"${repo_root}/scripts/delorean/run-local-verification.sh" "${verification_files[@]}"
else
	"${repo_root}/scripts/delorean/run-local-verification.sh"
fi

echo "Running pre-push OpenAPI check when backend API files changed."
"${repo_root}/scripts/delorean/run-openapi-checks.sh"
